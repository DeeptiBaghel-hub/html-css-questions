
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>University Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
        }

        /* ================= HEADER ================= */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;

            background: black;
            color: white;

            display: flex;
            align-items: center;

            padding: 0 20px;

            z-index: 1000;
        }

        .logo {
            margin-left: 50px;
            font-size: 20px;
            font-weight: bold;
        }

        /* ================= NAVBAR ================= */

        nav {
            margin-left: auto;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 25px;
        }

        nav a:hover {
            color: #00bfff;
        }

        /* ================= CHECKBOX ================= */

        #menu {
            display: none;
        }

        /* ================= HAMBURGER ================= */

        .hamburger {
            position: fixed;

            top: 14px;
            left: 20px;

            color: white;
            font-size: 28px;

            cursor: pointer;

            z-index: 1100;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            position: fixed;

            top: 60px;
            left: 0;

            width: 250px;
            height: calc(100vh - 60px);

            background: #111;
            color: white;

            padding: 25px 20px;

            transform: translateX(-100%);
            transition: transform 0.4s ease;

            z-index: 900;
        }

        /* Sidebar open */



        /* ================= SIDEBAR LINKS ================= */

        .sidebar h2 {
            margin-bottom: 25px;
        }

        .sidebar div {
            margin: 15px 0;
        }

        .sidebar a {
            color: white;
            text-decoration: none;

            display: block;

            padding: 10px;

            border-radius: 5px;
        }

        .sidebar a:hover {
            background: #333;
        }

        /* ================= MAIN CONTENT ================= */

        main {
            padding: 100px 30px 30px;

            min-height: 100vh;

            transition: margin-left 0.4s ease;
        }

        /* Content moves when sidebar opens */

        #menu:checked~main {
            margin-left: 250px;
        }

        #menu:checked~.sidebar {
            transform: translateX(0);
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="logo">
            University Portal
        </div>

        <nav>
            <a href="#">Home</a>
            <a href="#">Courses</a>
            <a href="#">Profile</a>
        </nav>

    </header>


    <!-- HIDDEN CHECKBOX -->

    <input type="checkbox" id="menu">


    <!-- HAMBURGER -->

    <label for="menu" class="hamburger">
        ☰
    </label>


    <!-- SIDEBAR -->

    <div class="sidebar">

        <h2>Menu</h2>

        <div>
            <a href="#">Dashboard</a>
        </div>

        <div>
            <a href="#">Courses</a>
        </div>

        <div>
            <a href="#">Settings</a>
        </div>

        <div>
            <a href="#">Logout</a>
        </div>

    </div>


    <!-- MAIN CONTENT -->

    <main>

        <h1>Welcome to my University</h1>

        <br>

        <p>
            This is the main content of the University Portal.
            Your content will remain visible when the sidebar opens.
        </p>

    </main>

</body>

</html>
