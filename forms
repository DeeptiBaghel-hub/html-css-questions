<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google form</title>
    <style>
        * {
            margin: 0%;
            padding: 0%;
            box-sizing: border-box;
        }

        html,body {
            height: 100%;
            width: 100%;
        }

        body {
            min-height: 100vh;
            background-color: #f2f2f2; 

            display: flex;
            justify-content: center;
            align-items: flex-start;
           
        }

        .form-container {
            width: 600px;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
        }
        .form-header {
            text-align: center;
            margin-bottom: 20px;
        }
        form{
            display:flex;
            flex-direction: column;
            
        }
        input,
        select,
        textarea {
            
            padding: 10px;
            font-size: 16px;
        }
        button{
            color:white;
            width:100px;
            padding:10px;
            background-color:blue;
            border-radius:5px;
            cursor: pointer;
            border:none;
            
        }
    </style>
</head>

<body>
    <div class="form-container">
        <div class="form-header">
            <h1>Student Registration Form</h1>
            <p>Please fill out the information below.</p>
        </div>
        <form action="/register" method="POST">
            <label for="name">Full name:</label>
            <input type="text" id="name" name="name" placeholder="Enter your name">
            <br><br>
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" placeholder="Enter your email">
            <br><br>
            <label for="age">Age:</label>
            <input type="number" id="age" name="age" placeholder="Enter your Age">
            <br><br>
            <label for="dob">DOB:</label>
            <input type="date" id="dob" name="dob" placeholder="">
            <br><br>

            <label>Gender:</label>
            <br><br>
            <label for="female">
                <input type="radio" name="gender" value="female" id="female"> female
            </label>
            <br><br>

            <label for="male">
                <input type="radio" name="gender" value="male" id="male"> Male
            </label>
            <br><br>
            <label for="others">
                <input type="radio" name="gender" value="others" id="others"> others
            </label>
            <br><br>
            <label>Skills:</label>
            <br><br>
            <label for="html">
                <input type="checkbox" name="skills" value="HTML" id="html"> HTML
            </label>
            <br><br>
            <label for="css">
                <input type="checkbox" name="skills" value="Css" id="css"> Css
            </label>

            <br><br>
            <label for="city">Select your city</label>
            <br><br>
            <select name="city" id="city">
                <option value="delhi">Delhi</option>
                <option value="Mumbai">Mumbai</option>
                <option value="Pune">Pune</option>
            </select>
            <br><br>
            <label>Enter your feedback:</label>
            <br><br>
            <textarea name="Feedback" id="feedback" rows="4" Feedback placeholder="Enter your feedback"></textarea>
            <br><br>
            <button type="submit">Submit</button>


        </form>

    </div>
</body>

</html>
